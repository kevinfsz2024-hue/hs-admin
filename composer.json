{
    "name": "hs/hs-admin",
    "description": "hs-admin - 基于 Dcat Admin 二次开发的后台系统构建工具，适配 Laravel 12",
    "type": "library",
    "keywords": [
        "hs-admin",
        "laravel",
        "laravel 12",
        "admin",
        "grid",
        "form",
        "laravel admin"
    ],
    "homepage": "https://github.com/kevinfsz2024-hue/hs-admin",
    "license": "MIT",
    "authors": [
        {
            "name": "kevinssz",
            "email": "szhansitech@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "spatie/eloquent-sortable": "^4.0",
        "dcat/easy-excel": "*"
    },
    "require-dev": {
        "laravel/dusk": "^8.0",
        "orchestra/testbench": "^10.0",
        "phpstan/phpstan": "~1.0",
        "phpunit/phpunit": "^11.5",
        "fakerphp/faker": "^1.23",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "Dcat\\Admin\\": "src/"
        },
        "files": [
            "src/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        },
        "files": [
            "tests/helpers.php"
        ]
    },
    "replace": {
        "dcat/laravel-admin": "self.version"
    },
    "scripts": {
        "phpstan": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Dcat\\Admin\\AdminServiceProvider"
            ]
        }
    }
}
